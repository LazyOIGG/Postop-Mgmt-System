# ============================================================
# 术后管理系统 - 环境变量配置模板
# 复制此文件为 .env 并填写实际值
# ============================================================

# ── 基础设置 ──
PROJECT_NAME="术后管理系统API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# ── DeepSeek API 配置 (必填) ──
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ── Neo4j 配置 (必填) ──
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_NAME=neo4j

# ── MySQL 配置 (必填) ──
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=RAG

# ── 模型路径配置 ──
BERT_MODEL_PATH=./model/chinese-roberta-wwm-ext
NER_MODEL_WEIGHTS=model/best_roberta_rnn_model_ent_aug.pt
TAG2IDX_PATH=tmp_data/tag2idx.npy

# ── 安全配置 (必填) ──
# 用于 JWT token 签名，请使用随机生成的密钥
SECRET_KEY=your_random_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── 默认管理员账户 ──
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_admin_password_here

# ── 阿里云百炼 Fun-ASR 配置 (可选，语音功能需要) ──
DASHSCOPE_API_KEY=

# ── 智谱AI配置 (可选，finetune_demo 需要) ──
ZHIPUAI_API_KEY=

# ── 预留多模态接口 ──
SPEECH_API_KEY=
IMAGE_API_KEY=

# ── 会话记忆配置 ──
MAX_CONVERSATION_HISTORY_TURNS=10
CONVERSATION_SUMMARY_THRESHOLD_CHARS=3000

# ── 工具调用配置 ──
MAX_TOOL_CALL_ROUNDS=3

# ── 知识图谱增强配置 ──
KG_MAX_HOPS=3
KG_VISUALIZE_MAX_NODES=50
KG_TEXT2CYPHER_ENABLED=true

# ── 推送通知配置 ──
NOTIFICATION_CHECK_INTERVAL=60

# ── 语音交互配置 ──
TTS_VOICE=longxiaochun
TTS_ENABLED=true

# ── Redis 配置 (可选，为空时降级为内存存储) ──
REDIS_URL=

# ── CORS 配置 ──
# Vue 前端开发服务器地址，多个用逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── 调试配置 ──
DEBUG=false
